# region model_provider
# 填写模型供应商凭据，费用与模型可用性由供应商拥有。
SILICONFLOW_API_KEY=
# DeepSeek 对话模型 API Key
DEEPSEEK_API_KEY=

# 身份安全配置：JWT 与 API Key 派生密钥必须分别生成并持久保存，初始化脚本会补齐留空值
RAG_ENV=development
RAG_JWT_SECRET_KEY=
RAG_API_KEY_DERIVATION_SECRET=
RAG_INSTANCE_ID=

# 默认启用知识库；关闭本地知识库容器使用 docker-compose.no-knowledge.yml，详见部署文档。
RAG_KNOWLEDGE_ENABLED=true

# 通用持久凭据加密：API 与 worker 使用同一 Fernet 密钥；勿复用 JWT 签名密钥。
# 生成：python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
RAG_ENCRYPTION_KEY=
# 浏览器可达的站点来源，如 https://rag.example.com；回调路径由代码固定。
RAG_PUBLIC_URL=

# CORS allowed origins for browser clients, comma-separated.
# Development defaults to http://localhost:5173,http://127.0.0.1:5173 when unset.
# Production does not allow cross-origin browser requests unless this is explicitly set.
RAG_CORS_ORIGINS=

# 实例名称与数据目录；部署及备份见 docs/advanced/deployment.md。
COMPOSE_PROJECT_NAME=rag
RAG_STATE_DIR=./docker/volumes

# # 其余可选配置
# OPENAI_API_KEY=
# OPENAI_API_BASE=
# ZHIPUAI_API_KEY=
# DASHSCOPE_API_KEY=
# ARK_API_KEY=
# MINIMAX_API_KEY=  # MiniMax 大模型 https://platform.minimaxi.com/
# TOGETHER_API_KEY=
# # endregion model_provider

# Production credentials (required by docker-compose.prod.yml)
RAG_POSTGRES_PASSWORD=
RAG_MINIO_ACCESS_KEY=
RAG_MINIO_SECRET_KEY=
# Public images use the frontend same-origin proxy by default.
# RAG_MINIO_PUBLIC_URL=/minio

# # region neo4j
# RAG_NEO4J_URI=
# RAG_NEO4J_USERNAME=
RAG_NEO4J_PASSWORD=
# # endregion neo4j

# # Services
# # ARQ worker 单任务最长执行时间（秒），默认 3600，长耗时任务需调大
# RAG_JOB_TIMEOUT_SECONDS=3600
# RAG_WORKER_HEALTH_INTERVAL_SECONDS=5  # 必须大于 0 且不超过 10；过长会破坏 worker 故障探测
# RAG_READINESS_PROBE_TIMEOUT_SECONDS=2
# RAG_READINESS_CACHE_TTL_SECONDS=1

# # URL Whitelist (comma-separated domains/IPs, empty to disable URL parsing)
# RAG_URL_WHITELIST=github.com,docs.example.com,gitlab.example.com,127.0.0.1

# # MinerU
# RAG_MINERU_API_KEY=

# # PaddleOCR API
# RAG_PADDLEOCR_API_TOKEN=
# RAG_PADDLEOCR_API_URL=https://paddleocr.aistudio-app.com/api/v2/ocr/jobs

# 唯一沙盒后端：container
RAG_SANDBOX_BACKEND=container

RAG_SANDBOX_IDLE_SECONDS=300
# RAG_SANDBOX_EXEC_TIMEOUT_SECONDS=180
# RAG_SANDBOX_MAX_OUTPUT_BYTES=262144

# Container 沙盒：仅单租户/可信代码使用，由默认 Compose 自动装配。
# RAG_SANDBOX_RUNNER_TOKEN=                 # 生产必填，初始化脚本会生成
# RAG_SANDBOX_RUNNER_URL=http://sandbox-runner:8090
# RAG_SANDBOX_CONTAINER_IMAGE=rag-sandbox:0.8.0.beta4
# RAG_SANDBOX_CONTAINER_IMAGE_DIGEST=       # 生产必填，sha256:...
# RAG_SANDBOX_CONTAINER_NETWORK=none        # none 或 bridge；bridge 会削弱网络隔离
# RAG_SANDBOX_CONTAINER_MEMORY_BYTES=1073741824
# RAG_SANDBOX_CONTAINER_CPUS=1
# RAG_SANDBOX_CONTAINER_PIDS_LIMIT=256
# RAG_SANDBOX_CONTAINER_HOME_BYTES=268435456
# RAG_SANDBOX_CONTAINER_TMP_BYTES=268435456
# RAG_SANDBOX_CONTAINER_MAX_CONTAINERS=32
# RAG_SANDBOX_CONTAINER_MAX_EXECS=8
# RAG_SANDBOX_CONTAINER_MAX_LIFETIME_SECONDS=7200
# RAG_SANDBOX_CONTAINER_UID=1000
# RAG_SANDBOX_CONTAINER_GID=1000
# runner 容器内的数据/Skill 挂载点；直接运行 runner 时改成宿主实际路径
# RAG_SANDBOX_CONTAINER_DATA_MOUNT=/sandbox-data
# RAG_SANDBOX_CONTAINER_SKILL_MOUNT=/sandbox-skill-projections
# 仅 runner 在容器外运行时需要显式给出 Docker daemon 视角的宿主路径
# RAG_SANDBOX_CONTAINER_HOST_DATA_DIR=
# RAG_SANDBOX_CONTAINER_HOST_SKILL_DIR=

# Worker 作业并发上限（包含 AgentRun 与知识作业，默认 10）
# RAG_ARQ_MAX_JOBS=10
# Redis 值是对应进程内每个客户端池的连接上限；进程可按需创建多个池，且不会预先建满。
# RAG_API_REDIS_MAX_CONNECTIONS=256
# RAG_WORKER_REDIS_MAX_CONNECTIONS=256
# RAG_API_POSTGRES_POOL_SIZE=120
# RAG_API_POSTGRES_MAX_OVERFLOW=40
# RAG_API_POSTGRES_POOL_TIMEOUT_SECONDS=30
# RAG_API_LANGGRAPH_POSTGRES_POOL_SIZE=10
# RAG_API_LANGGRAPH_POSTGRES_POOL_TIMEOUT_SECONDS=30
# RAG_WORKER_POSTGRES_POOL_SIZE=120
# RAG_WORKER_POSTGRES_MAX_OVERFLOW=40
# RAG_WORKER_POSTGRES_POOL_TIMEOUT_SECONDS=30
# RAG_WORKER_LANGGRAPH_POSTGRES_POOL_SIZE=120
# RAG_WORKER_LANGGRAPH_POSTGRES_POOL_TIMEOUT_SECONDS=30
# RAG_POSTGRES_MAX_CONNECTIONS=600

# Milvus 知识库与图向量使用同一数据库，API / worker 重建后生效
RAG_MILVUS_DB=rag

# Milvus 容器 CPU 上界（重建容器后生效；让镜像内置 maxprocs 按 cgroup quota 收敛 GOMAXPROCS）
# 内存随知识库数据量线性增长，故意不设上限：硬上界只会在数据合法增长时
# 把容器推入 OOM→重启→重加载→再 OOM 的循环，监控告警比 kill 更合适
# RAG_MILVUS_CPUS=2

# 企业 OIDC 默认关闭；以下变量由身份模块读取，启用前核对实际身份供应商配置。
RAG_OIDC_ENABLED=false
RAG_OIDC_PROVIDER_NAME=企业统一登录
RAG_OIDC_ISSUER_URL=
RAG_OIDC_CLIENT_ID=
RAG_OIDC_CLIENT_SECRET=
RAG_OIDC_REDIRECT_URI=

# 仅隔离实验可列出准确 HTTP 来源，以逗号分隔；生产留空。
RAG_API_PORT=25050
RAG_FRONTEND_PORT=25173
RAG_POSTGRES_PORT=25432
RAG_REDIS_PORT=26379
RAG_MINIO_API_PORT=29000
RAG_MINIO_CONSOLE_PORT=29001
RAG_MILVUS_PORT=29530
RAG_MILVUS_HEALTH_PORT=29091
RAG_NEO4J_HTTP_PORT=27474
RAG_NEO4J_BOLT_PORT=27687
